{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "serenity-ui",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2025-08-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  }
}
